{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$connection": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name','at'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      ".indexOn": [
        "createdAt"
      ],
      "$room": {
        ".write": "(auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val() || (auth != null && auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() && root.child('rooms').child($room).child('meta').child('status').val() == 'closed' && !newData.exists())) || (auth != null && (auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('authority/uid').val()) && root.child('rooms').child($room).child('meta/status').val() == 'finished' && !newData.exists())",
        ".validate": "newData.hasChildren(['room','title','owner','status','mode','createdAt'])",
        "room": {
          ".validate": "newData.val() == $room"
        },
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "owner": {
          ".validate": "newData.val() == root.child('rooms').child($room).child('authority').child('uid').val()"
        },
        "status": {
          ".validate": "newData.val() == root.child('rooms').child($room).child('meta').child('status').val()"
        },
        "mode": {
          ".validate": "newData.val() == root.child('rooms').child($room).child('meta').child('mode').val()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "p0": {
          ".validate": "newData.val() == root.child('rooms').child($room).child('meta/p0').val()"
        },
        "p1": {
          ".validate": "newData.val() == root.child('rooms').child($room).child('meta/p1').val()"
        }
      }
    },
    "rooms": {
      "$room": {
        ".write": "(auth != null && ((!data.exists() && newData.child('meta/p0').val() == auth.uid && newData.child('authority/uid').val() == auth.uid && $room.matches(/^[A-Z0-9]{8}$/)) || (!newData.exists() && data.child('meta/p0').val() == auth.uid && data.child('meta/status').val() == 'closed'))) || (auth != null && (auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('authority/uid').val()) && root.child('rooms').child($room).child('meta/status').val() == 'finished' && !newData.exists())",
        ".validate": "newData.hasChildren(['meta','authority'])",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val()",
          "id": {
            ".validate": "newData.val() == $room"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "p0": {
            ".validate": "newData.isString() && ((!data.exists() && newData.val() == auth.uid) || newData.val() == data.val())"
          },
          "p1": {
            ".write": "auth != null && !data.exists() && newData.val() == auth.uid && auth.uid != root.child('rooms').child($room).child('meta').child('p0').val() && root.child('rooms').child($room).child('meta').child('status').val() == 'waiting'",
            ".validate": "newData.isString() && newData.val().length <= 128 && (newData.val() == data.val() || (!data.exists() && (newData.val() == auth.uid || (newData.val() == 'AI' && auth.uid == newData.parent().child('p0').val()))))"
          },
          "status": {
            ".validate": "newData.val() == 'waiting' || newData.val() == 'running' || newData.val() == 'finished' || newData.val() == 'closed'"
          },
          "mode": {
            ".validate": "newData.val() == 'strict' || newData.val() == 'numeric'"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() == data.val())"
          },
          "$other": {
            ".validate": false
          },
          ".validate": "newData.hasChildren(['id','title','p0','status','mode','createdAt'])",
          "p0Name": {
            ".write": "auth != null && auth.uid == root.child('rooms').child($room).child('meta/p0').val()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && (newData.val() == data.val() || auth.uid == newData.parent().child('p0').val())"
          },
          "p1Name": {
            ".write": "auth != null && auth.uid == root.child('rooms').child($room).child('meta/p1').val()",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && (newData.val() == data.val() || auth.uid == newData.parent().child('p1').val() || (newData.parent().child('p1').val() == 'AI' && auth.uid == newData.parent().child('p0').val()))"
          },
          "rematch": {
            "$uid": {
              ".write": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('meta/p1').val()) && auth.uid == $uid && root.child('rooms').child($room).child('meta/status').val() == 'finished'",
              ".validate": "newData.isString() && auth.uid == $uid && newData.val() == (root.child('rooms').child($room).child('bundle/matchId').exists() ? root.child('rooms').child($room).child('bundle/matchId').val() : 'room-'+$room) && root.child('rooms').child($room).child('meta/status').val() == 'finished'"
            }
          },
          "names": {
            "$uid": {
              ".write": "auth != null && auth.uid == $uid && (auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('meta/p1').val())",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && ((auth.uid == $uid && ($uid == newData.parent().parent().child('p0').val() || $uid == newData.parent().parent().child('p1').val())) || (newData.val() == data.val()) || ($uid == 'AI' && newData.parent().parent().child('p1').val() == 'AI' && auth.uid == newData.parent().parent().child('p0').val()))"
            }
          }
        },
        "authority": {
          ".read": "(auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val())) || (auth != null && !(auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('meta/p1').val()) && root.child('rooms').child($room).child('spectators').child(auth.uid).exists() && (root.child('rooms').child($room).child('meta/status').val() == 'running' || root.child('rooms').child($room).child('meta/status').val() == 'finished'))",
          ".write": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && newData.hasChildren(['uid','connection','term']) && newData.child('uid').val() == auth.uid && newData.child('term').val() == data.child('term').val()+1 && !root.child('rooms').child($room).child('presence').child(data.child('uid').val()).child(data.child('connection').val()).exists() && root.child('rooms').child($room).child('presence').child(auth.uid).child(newData.child('connection').val()).exists()",
          ".validate": "newData.hasChildren(['uid','connection','term'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "connection": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "term": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 == 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "presence": {
          ".read": "(auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val())) || (auth != null && !(auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('meta/p1').val()) && root.child('rooms').child($room).child('spectators').child(auth.uid).exists() && (root.child('rooms').child($room).child('meta/status').val() == 'running' || root.child('rooms').child($room).child('meta/status').val() == 'finished'))",
          "$uid": {
            "$connection": {
              ".write": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && auth.uid == $uid",
              ".validate": "newData.hasChildren(['name','at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "settings": {
          ".read": "auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val()",
          "$uid": {
            ".read": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && auth.uid == $uid",
            ".write": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && root.child('rooms').child($room).child('meta').child('status').val() == 'waiting' && (auth.uid == $uid || ($uid == 'AI' && auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val()))",
            ".validate": "newData.hasChildren(['deckJSON','ready'])",
            "deckJSON": {
              ".validate": "newData.isString() && newData.val().length <= 16000"
            },
            "ready": {
              ".validate": "newData.val() == true"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "commands": {
          ".read": "auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val()",
          "$uid": {
            ".read": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && auth.uid == $uid",
            "$cmd": {
              ".write": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && auth.uid == $uid && !data.exists() && root.child('rooms').child($room).child('meta').child('status').val() == 'running'",
              ".validate": "newData.hasChildren(['body','term','createdAt'])",
              "body": {
                ".validate": "newData.isString() && newData.val().length <= 24000"
              },
              "term": {
                ".validate": "newData.val() == root.child('rooms').child($room).child('authority').child('term').val()"
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "bundle": {
          ".read": "auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val()",
          ".write": "auth != null && auth.uid == root.child('rooms').child($room).child('authority').child('uid').val() && root.child('rooms').child($room).child('presence').child(auth.uid).child(root.child('rooms').child($room).child('authority').child('connection').val()).exists() && root.child('rooms').child($room).child('meta').child('status').val() != 'closed' && newData.child('term').val() == root.child('rooms').child($room).child('authority').child('term').val() && newData.child('writer').val() == root.child('rooms').child($room).child('authority').child('connection').val()",
          ".validate": "newData.hasChildren(['term','revision','writer','checkpointJSON','logJSON','views','updatedAt']) && (!data.child('matchId').exists() || newData.child('matchId').exists())",
          "term": {
            ".validate": "newData.isNumber()"
          },
          "writer": {
            ".validate": "newData.isString()"
          },
          "revision": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() == 0) || newData.val() == data.val()+1)"
          },
          "checkpointJSON": {
            ".validate": "newData.isString() && newData.val().length <= 4000000"
          },
          "logJSON": {
            ".validate": "newData.isString() && newData.val().length <= 4000000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "views": {
            "$uid": {
              ".read": "auth != null && (auth.uid == root.child('rooms').child($room).child('meta').child('p0').val() || auth.uid == root.child('rooms').child($room).child('meta').child('p1').val()) && auth.uid == $uid",
              ".validate": "newData.isString() && newData.val().length <= 800000 && ($uid == root.child('rooms').child($room).child('meta').child('p0').val() || $uid == root.child('rooms').child($room).child('meta').child('p1').val())"
            }
          },
          "$other": {
            ".validate": false
          },
          "matchId": {
            ".validate": "newData.isString() && newData.val().length <= 160 && (!data.parent().exists() || newData.val() == (data.parent().child('matchId').exists() ? data.parent().child('matchId').val() : 'room-'+$room) || (root.child('rooms').child($room).child('meta/status').val() == 'finished' && root.child('rooms').child($room).child('meta/rematch').child(root.child('rooms').child($room).child('meta/p0').val()).val() == (data.parent().child('matchId').exists() ? data.parent().child('matchId').val() : 'room-'+$room) && (root.child('rooms').child($room).child('meta/p1').val() == 'AI' || root.child('rooms').child($room).child('meta/rematch').child(root.child('rooms').child($room).child('meta/p1').val()).val() == (data.parent().child('matchId').exists() ? data.parent().child('matchId').val() : 'room-'+$room))))"
          },
          "spectator": {
            ".read": "auth != null && !(auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('meta/p1').val()) && root.child('rooms').child($room).child('spectators').child(auth.uid).exists() && (root.child('rooms').child($room).child('meta/status').val() == 'running' || root.child('rooms').child($room).child('meta/status').val() == 'finished')",
            ".validate": "newData.isString() && newData.val().length <= 1000000 && newData.val().contains('\"spectator\":true') && !newData.val().contains('\"checkpoint\"') && !newData.val().contains('\"snapshot\"')"
          }
        },
        "$other": {
          ".validate": false
        },
        "spectators": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            "$connection": {
              ".write": "auth != null && auth.uid == $uid && (!newData.exists() || (!(auth.uid == root.child('rooms').child($room).child('meta/p0').val() || auth.uid == root.child('rooms').child($room).child('meta/p1').val()) && (root.child('rooms').child($room).child('meta/status').val() == 'running' || root.child('rooms').child($room).child('meta/status').val() == 'finished')))",
              ".validate": "auth != null && auth.uid == $uid && newData.hasChildren(['name','at','accepted']) && $connection.matches(/^[a-zA-Z0-9_-]{1,80}$/)",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() == now"
              },
              "accepted": {
                ".validate": "newData.val() == true"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "personalDecks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        "$deck": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChildren(['version','name','cardsJSON','cardCount','eventCount','createdAt'])",
          "version": {
            ".validate": "newData.val() == 1"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "cardsJSON": {
            ".validate": "newData.isString() && newData.val().length <= 16000"
          },
          "cardCount": {
            ".validate": "newData.val() == 40"
          },
          "eventCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "publicDecks": {
      ".read": "query.orderByChild == 'createdAt' && query.limitToLast != null && query.limitToLast <= 30",
      ".indexOn": [
        "createdAt"
      ],
      "$deck": {
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((!data.exists() && newData.child('owner').val() == auth.uid) || (data.child('owner').val() == auth.uid && (!newData.exists() || newData.child('owner').val() == auth.uid)))",
        ".validate": "newData.hasChildren(['version','owner','author','name','cardsJSON','cardCount','eventCount','createdAt'])",
        "version": {
          ".validate": "newData.val() == 1"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
        },
        "cardsJSON": {
          ".validate": "newData.isString() && newData.val().length <= 16000"
        },
        "cardCount": {
          ".validate": "newData.val() == 40"
        },
        "eventCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        },
        ".read": true,
        "owner": {
          ".validate": "newData.isString() && newData.val() == auth.uid"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        }
      }
    },
    "playerProfiles": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        ".validate": "newData.hasChildren(['name','avatar','updatedAt'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "avatar": {
          ".validate": "newData.isString() && (newData.val() == '' || (newData.val().length <= 24000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/]+={0,2}$/)))"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "archiveWriters": {
      "$id": {
        ".read": false,
        ".write": "auth != null && $id.matches(/^[a-f0-9]{32}$/) && newData.child('uid').val() == auth.uid && (!data.exists() || (newData.child('room').val() == data.child('room').val() && newData.child('matchId').val() == data.child('matchId').val())) && auth.uid == root.child('rooms').child(newData.child('room').val()).child('authority/uid').val() && root.child('rooms').child(newData.child('room').val()).child('meta/status').val() == 'finished' && newData.child('matchId').val() == root.child('rooms').child(newData.child('room').val()).child('bundle/matchId').val()",
        ".validate": "newData.hasChildren(['uid','room','matchId'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "room": {
          ".validate": "newData.isString()"
        },
        "matchId": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "publicReplays": {
      "$id": {
        ".read": true,
        ".write": "(!data.exists() && auth != null && auth.uid == root.child('archiveWriters').child($id).child('uid').val() && auth.uid == root.child('rooms').child(root.child('archiveWriters').child($id).child('room').val()).child('authority/uid').val() && root.child('rooms').child(root.child('archiveWriters').child($id).child('room').val()).child('meta/status').val() == 'finished' && root.child('archiveWriters').child($id).child('matchId').val() == root.child('rooms').child(root.child('archiveWriters').child($id).child('room').val()).child('bundle/matchId').val()) || (auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('researchWriters').child($id).child('uid').val() == auth.uid && (!newData.exists() || (!data.exists() && root.child('playerAgreements').child(auth.uid).child('version').val() == 1 && root.child('playerAgreements').child(auth.uid).child('usage').val() == true && root.child('playerAgreements').child(auth.uid).child('research').val() == true && root.child('playerAgreements').child(auth.uid).child('researchEnabled').val() == true && root.child('researchPublications').child(auth.uid).child(root.child('researchWriters').child($id).child('slot').val()).child('id').val() == $id)))",
        ".validate": "$id.matches(/^[a-f0-9]{32}$/) && newData.isString() && newData.val().length > 100 && newData.val().length <= 750000 && !newData.val().contains('\"uid\"') && !newData.val().contains('\"room\"') && !newData.val().contains('\"email\"') && !newData.val().contains('\"snapshot\"')"
      }
    },
    "publicReplayIndex": {
      ".read": "query.orderByChild == 'createdAt' && query.limitToLast != null && query.limitToLast <= 20",
      ".indexOn": [
        "createdAt"
      ],
      "$id": {
        ".read": true,
        ".write": "(!data.exists() && root.child('publicReplays').child($id).exists() && auth != null && auth.uid == root.child('archiveWriters').child($id).child('uid').val() && auth.uid == root.child('rooms').child(root.child('archiveWriters').child($id).child('room').val()).child('authority/uid').val() && root.child('rooms').child(root.child('archiveWriters').child($id).child('room').val()).child('meta/status').val() == 'finished' && root.child('archiveWriters').child($id).child('matchId').val() == root.child('rooms').child(root.child('archiveWriters').child($id).child('room').val()).child('bundle/matchId').val()) || (auth != null && auth.token.firebase.sign_in_provider == 'google.com' && root.child('researchWriters').child($id).child('uid').val() == auth.uid && (!newData.exists() || (!data.exists() && root.child('playerAgreements').child(auth.uid).child('version').val() == 1 && root.child('playerAgreements').child(auth.uid).child('usage').val() == true && root.child('playerAgreements').child(auth.uid).child('research').val() == true && root.child('playerAgreements').child(auth.uid).child('researchEnabled').val() == true && root.child('researchPublications').child(auth.uid).child(root.child('researchWriters').child($id).child('slot').val()).child('id').val() == $id && root.child('publicReplays').child($id).exists())))",
        ".validate": "newData.hasChildren(['version','createdAt','rallies','winner','steps','mode','bytes'])",
        "version": {
          ".validate": "newData.val() == 1"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now"
        },
        "rallies": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "winner": {
          ".validate": "newData.val() == 0 || newData.val() == 1"
        },
        "steps": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 6000"
        },
        "mode": {
          ".validate": "newData.val() == 'strict' || newData.val() == 'numeric'"
        },
        "bytes": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 3000000"
        },
        "$other": {
          ".validate": false
        },
        "origin": {
          ".validate": "newData.val() == 'solo-ai-research'"
        },
        "aiLevel": {
          ".validate": "newData.val() == 'easy' || newData.val() == 'normal' || newData.val() == 'hard'"
        },
        "aiVersion": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        }
      }
    },
    "personalMatches": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        "$id": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && (!newData.exists() || (!data.exists() && newData.child('previousRecordId').val() == '') || (data.exists() && (newData.child('recordId').val() == data.child('recordId').val() || newData.child('previousRecordId').val() == data.child('recordId').val())))",
          ".validate": "$id.matches(/^s[0-2][0-9]$/) && newData.hasChildren(['recordId','previousRecordId','version','recordJSON','createdAt','updatedAt'])",
          "version": {
            ".validate": "newData.val() == 1"
          },
          "recordJSON": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 900000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          },
          "recordId": {
            ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().beginsWith('solo:')"
          },
          "previousRecordId": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          }
        }
      }
    },
    "personalMatchIndex": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        ".indexOn": [
          "updatedAt"
        ],
        "$id": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && (!newData.exists() || (!data.exists() && newData.child('previousRecordId').val() == '') || (data.exists() && (newData.child('recordId').val() == data.child('recordId').val() || newData.child('previousRecordId').val() == data.child('recordId').val())))",
          ".validate": "$id.matches(/^s[0-2][0-9]$/) && newData.hasChildren(['recordId','previousRecordId','version','result','rally','decisionIndex','chars','createdAt','updatedAt'])",
          "version": {
            ".validate": "newData.val() == 1"
          },
          "recordId": {
            ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().beginsWith('solo:')"
          },
          "result": {
            ".validate": "newData.val() == 'win' || newData.val() == 'loss'"
          },
          "rally": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
          },
          "decisionIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "chars": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 900000"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          },
          "previousRecordId": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          }
        }
      }
    },
    "playerAgreements": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        ".validate": "newData.hasChildren(['version','usage','research','researchEnabled','acceptedAt','updatedAt'])",
        "version": {
          ".validate": "newData.val() == 1"
        },
        "usage": {
          ".validate": "newData.val() == true"
        },
        "research": {
          ".validate": "newData.val() == true"
        },
        "researchEnabled": {
          ".validate": "newData.isBoolean()"
        },
        "acceptedAt": {
          ".validate": "newData.isNumber() && (newData.val() == now || newData.val() == data.val())"
        },
        "updatedAt": {
          ".validate": "newData.val() == now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "researchPublications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        "$slot": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && (!newData.exists() || (root.child('playerAgreements').child(auth.uid).child('version').val() == 1 && root.child('playerAgreements').child(auth.uid).child('usage').val() == true && root.child('playerAgreements').child(auth.uid).child('research').val() == true && root.child('playerAgreements').child(auth.uid).child('researchEnabled').val() == true && (!data.exists() || newData.child('id').val() == data.child('id').val()) && newData.child('recordId').val() == root.child('personalMatchIndex').child($uid).child($slot).child('recordId').val()))",
          ".validate": "$slot.matches(/^s[0-2][0-9]$/) && newData.hasChildren(['id','recordId','createdAt'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "recordId": {
            ".validate": "newData.isString() && newData.val().beginsWith('solo:')"
          },
          "createdAt": {
            ".validate": "newData.val() == now || newData.val() == data.val()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "researchWriters": {
      "$id": {
        ".read": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid)",
        ".write": "auth != null && auth.token.firebase.sign_in_provider == 'google.com' && ((!newData.exists() && data.child('uid').val() == auth.uid) || (!data.exists() && root.child('playerAgreements').child(auth.uid).child('version').val() == 1 && root.child('playerAgreements').child(auth.uid).child('usage').val() == true && root.child('playerAgreements').child(auth.uid).child('research').val() == true && root.child('playerAgreements').child(auth.uid).child('researchEnabled').val() == true && newData.child('uid').val() == auth.uid && root.child('researchPublications').child(auth.uid).child(newData.child('slot').val()).child('id').val() == $id && root.child('researchPublications').child(auth.uid).child(newData.child('slot').val()).child('recordId').val() == newData.child('recordId').val()))",
        ".validate": "$id.matches(/^[a-f0-9]{32}$/) && newData.hasChildren(['uid','slot','recordId'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "slot": {
          ".validate": "newData.isString() && newData.val().matches(/^s[0-2][0-9]$/)"
        },
        "recordId": {
          ".validate": "newData.isString() && newData.val().beginsWith('solo:')"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "syncedDecks": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com'",
        "$id": {
          ".write": "auth != null && auth.uid == $uid && auth.token.firebase.sign_in_provider == 'google.com' && newData.exists() && ((!data.exists() && newData.child('previous').val() == '') || (data.exists() && newData.child('previous').val() == data.child('rev').val() && newData.child('rev').val() != data.child('rev').val()))",
          ".validate": "$id.matches(/^my_[a-zA-Z0-9_-]+$/) && newData.hasChildren(['version','rev','previous','name','cardsJSON','cardCount','eventCount','visible','publicId','deleted','updatedAt'])",
          "version": {
            ".validate": "newData.val() == 1"
          },
          "rev": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-zA-Z0-9_-]{16,64}$/)"
          },
          "previous": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "cardsJSON": {
            ".validate": "newData.isString() && newData.val().length <= 16000"
          },
          "cardCount": {
            ".validate": "newData.val() == 40"
          },
          "eventCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
          },
          "visible": {
            ".validate": "newData.isBoolean()"
          },
          "deleted": {
            ".validate": "newData.isBoolean()"
          },
          "publicId": {
            ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^pub_[a-zA-Z0-9_-]+$/))"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() == now"
          },
          "$other": {
            ".validate": false
          },
          "legacyJSON": {
            ".validate": "newData.isString() && newData.val().length <= 16000"
          }
        }
      }
    }
  }
}
